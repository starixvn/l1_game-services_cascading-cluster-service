{
    "name": "cascading-cluster-client",
    "version": "1.0.0",
    "description": "Standalone client for cascading cluster game service",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "node --import=extensionless/register InteractiveCLI.js",
        "play": "node --import=extensionless/register launchGame.js",
        "client": "node --import=extensionless/register InteractiveCLI.js",
        "simple": "node --import=extensionless/register examples/runSimpleClient.js",
        "scenarios": "node --import=extensionless/register examples/runScenarioClient.js",
        "test-logs": "node --import=extensionless/register test-logs.js",
        "test-bet-failure": "node --import=extensionless/register test-bet-failure.js"
    },
    "bin": {
        "game-client": "./InteractiveCLI.js"
    },
    "keywords": [
        "game",
        "client",
        "socket",
        "casino",
        "slot",
        "cascading"
    ],
    "author": "pentagon",
    "license": "ISC",
    "dependencies": {
        "sc-game-service-integration-utils": "2.3.0",
        "axios": "^1.0.0"
    },
    "engines": {
        "node": ">=14.0.0"
    }
}
